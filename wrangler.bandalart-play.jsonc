// 반다라트 Google Play 심사 상태 알림. 15분마다 internal·production 트랙의 releaseLifecycleState를 조회한다(할당량: docs/QUOTAS.md).
// 비밀값: GOOGLE_SERVICE_ACCOUNT_JSON(서비스 계정 JSON 키 파일 내용), DISCORD_WEBHOOK_URL
// D1 테이블: migrations/0003_play_releases.sql. 이 D1은 0001을 마이그레이션 기록 없이 만들어서
// `d1 migrations apply`를 쓰지 않고 `d1 execute --file`로 0003만 적용한다(docs/PLAY_WORKER_OPERATIONS.md).
{
  "name": "bandalart-play-release-ping",
  "main": "src/play-release-worker.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "PACKAGE_NAME": "com.nexters.bandalart",
    "TRACKS": "[\"internal\",\"production\"]"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "bandalart-ios-webhook-events", "database_id": "4415c672-cf8c-4aff-9792-4952a45624c8" }
  ]
}
